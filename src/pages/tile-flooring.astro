---
/**
 * /tile-flooring — Tile Floor Installation landing page (Google Ads).
 *
 * Distinct visual identity from /wood-flooring (per client): FloorDaddy-style
 * CENTERED, trust-driven hero (value headline + guarantee callouts + badge row),
 * a neon-PINK eye-catch replacing the wood page's lime, a deeper blue, and tile
 * mosaic motifs + tile-relevant icons. All scoped to .tile-theme (see global.css);
 * the wood page is untouched. NO promo creatives on this page (the client's promo
 * graphics show wood floors) — pulled until tile-specific creatives are supplied.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import LeadForm from "@/components/LeadForm.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import Guarantees from "@/components/Guarantees.astro";
import CreativeBanner from "@/components/CreativeBanner.astro";
import { siteConfig, approvedOffers, approvedGuarantees, readyReviews } from "@/lib/siteConfig";
import { formatPhone, telHref, smsHref } from "@/lib/phone";

const SLUG = "tile-flooring";
const { phones, photos, business, serviceArea } = siteConfig;
const phone = formatPhone(phones.primary);
const offer = approvedOffers()[0]?.text ?? "";

const metro = "Phoenix & the East Valley";

// Client-branded tile promo creatives (self-hosted under /public/creatives/tile).
// Distributed across the page at relevant points (not all in one wall).
const creatives = {
  patterned:  { src: "/creatives/tile/tile-2.jpg", alt: "Interest-free for 12 months on patterned tile floors, with 10% off for veterans." },
  financing:  { src: "/creatives/tile/tile-5.jpg", alt: "0% financing for 12 months on new tile floors, plus 10% off for veterans and seniors." },
  discount:   { src: "/creatives/tile/tile-3.jpg", alt: "Senior discounts on all flooring jobs, plus a thank-you discount for veterans." },
  speed:      { src: "/creatives/tile/tile-6.jpg", alt: "New tile floors in 3 days, with 10% off for veterans and seniors. Book a free estimate." },
  noInterest: { src: "/creatives/tile/tile-4.jpg", alt: "Upgrade your tile with no interest for a year, plus 10% off for veterans." },
  install:    { src: "/creatives/tile/tile-1.jpg", alt: "Interest-free for 12 months, with 10% off for veterans. Book a free estimate." },
};

// FAQ — lead-friction reducers, written from approved intake facts only.
const faqs = [
  { q: "How much does tile installation cost?", a: "Every home is different, so you get a clear written price during a free in-home estimate — honest up-front pricing, plus a price-match guarantee. The estimate is the price." },
  { q: "How long does a tile floor take?", a: "Most projects are completed in just 3 to 7 days, depending on size and prep. You'll get a firm timeline with your written quote." },
  { q: "Do you offer financing?", a: "Yes — ask us about 0% financing for qualified buyers. Veterans, active military, seniors, and first responders also save 10%." },
  { q: "Are you licensed and insured?", a: "Yes. We're a licensed Arizona contractor (AZ ROC #336899), locally owned, with our own installers on every job — never day-labor subs." },
  { q: "Will my grout crack down the line?", a: "Not when it's prepped right. We level the subfloor and waterproof wet areas first, then set the tile lippage-free with leveling clips and seal the grout." },
];

// Three short guarantee callouts for the hero (FloorDaddy-style checkmark row).
const heroGuarantees = approvedGuarantees().filter((g) =>
  ["warranty", "upfront", "price-match"].includes(g.key),
);

// Real, non-fabricated figures for the stats band.
const stats = [
  { num: "4.9", unit: "★", label: "Google rating" },
  { num: "103", unit: "+", label: "Google reviews" },
  { num: "24", unit: "mo", label: "Labor warranty" },
  { num: "3-7", unit: "", label: "Day installs" },
];

// Tile-specific craft strengths, each with a relevant icon (rendered below).
const tileFeatures = [
  { icon: "level",   tone: "bg-brand",     title: "Dead-flat, crack-resistant prep", body: "We level the subfloor so tile and grout don't crack, lift, or pop loose down the line." },
  { icon: "droplet", tone: "bg-pop",       title: "Waterproofed wet areas",          body: "The right membrane and backer board go down first, so moisture never gets under your tile." },
  { icon: "grid",    tone: "bg-gold",      title: "Lippage-free, laser-leveled",     body: "Leveling clips keep every edge flush, no toe-stubbing high spots, no uneven lippage." },
  { icon: "sparkle", tone: "bg-cta",       title: "Crisp, sealed grout lines",       body: "Even spacing and sealed grout that still looks sharp years from now." },
];

const steps = [
  { title: "Free in-home estimate", body: "We measure, talk tile, layout & grout, and give you a clear written quote." },
  { title: "Prep & waterproof", body: "Level the subfloor, set backer board, and waterproof wet areas before any tile goes down." },
  { title: "Precision set & seal", body: "Laser-leveled tile, even grout lines, sealed and polished, then we walk it with you." },
];

// Interactive tile-look selector using real Zona tile projects. Clicking a card
// pre-selects it in the lead form (shared script at the bottom).
const looks = [
  { name: "Decorative pattern", note: "Bold, eye-catching tile", img: photos.tile[0] },
  { name: "Marble-look", note: "Bright, timeless elegance", img: photos.tile[2] },
  { name: "Stone & dark tones", note: "Dramatic, modern depth", img: photos.tile[1] },
];

const projectOptions = ["Porcelain", "Ceramic", "Natural stone", "Marble-look", "Decorative pattern", "Other / not sure"];
const featureImg = photos.tile[0];
const teamPhotos = photos.team.slice(0, 3);

// Social proof — REAL verbatim Google reviews. Tile-specific first, then general.
const fmtName = (n: string) => {
  const [first, second] = n.trim().split(/\s+/);
  return second ? `${first} ${second[0]}.` : first;
};
const proof = [...readyReviews("tile"), ...readyReviews("general")]
  .slice(0, 4)
  .map((r) => ({ name: fmtName(r.name), note: r.verbatim }));

const LOGO_FILES: Record<string, { file: string; w: number; h: number }> = {
  Google: { file: "/logos/google.svg", w: 28, h: 28 },
  Yelp: { file: "/logos/yelp.svg", w: 28, h: 28 },
  Angi: { file: "/logos/angi.png", w: 46, h: 28 },
  BBB: { file: "/logos/bbbsvg.svg", w: 16, h: 28 },
  Nextdoor: { file: "/logos/nextdoor.svg", w: 28, h: 28 },
};

const ctaMicrocopy = `Licensed ${business.license.number} · Locally owned · No pressure, ever`;
const privacyNote = "Your info goes straight to our team. No spam, no third parties.";

const btnLift =
  "transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pop/70 focus-visible:ring-offset-2";
const cardLift = "transition-all duration-200 hover:-translate-y-1 hover:shadow-lg";
---

<Layout
  title="Tile Floor Installation in Phoenix & the East Valley | Zona Floors"
  description="Expert tile floor installation — porcelain, ceramic & natural stone. Licensed, insured, locally-owned Arizona crew. Free in-home estimate. Call or request a quote."
>
  <Header />

  <main class="tile-theme">
    <!-- ===================== URGENCY OFFER RIBBON ===================== -->
    <a href="#lead-form" class="group block bg-brand-dark text-white">
      <p class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-2 gap-y-0.5 px-5 py-2 text-center text-sm font-extrabold uppercase tracking-wide sm:text-base">
        <span class="animate-pulse" aria-hidden="true">🔥</span>
        <span class="text-pop">Limited time:</span>
        <span>0% financing for 12 months + 10% off veterans &amp; seniors</span>
        <span class="font-black text-gold underline decoration-2 underline-offset-2 transition group-hover:no-underline">Book now →</span>
      </p>
    </a>

    <!-- ===================== HERO (centered, trust-driven, mosaic) ===================== -->
    <section class="relative isolate overflow-hidden text-brand">
      <!-- Client tile photo as the hero background (watermark removed, optimized). -->
      <img
        src="/creatives/tile/hero.jpg"
        alt="Bright Arizona kitchen with marble-look tile floor installed by Zona Floors"
        fetchpriority="high" loading="eager" decoding="async"
        width="1500" height="2001" sizes="100vw"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <!-- Light overlay: subtle — keeps the tile vivid, just softens it for legibility. -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-white/55 via-white/35 to-white/20"></div>

      <div class="text-shadow-glow mx-auto max-w-3xl px-5 pb-12 pt-6 text-center sm:pt-10">
        <p data-reveal class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-bold text-brand shadow-md ring-1 ring-brand/10 sm:text-base">
          <span class="text-gold" aria-hidden="true">★★★★★</span> 5-Star Rated on Google · 4.9 · 103+ reviews
        </p>

        <h1 class="mt-5 text-4xl font-extrabold leading-[1.02] text-brand sm:text-5xl">
          Tile Floor Installation in <span class="text-pop">{metro}</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-xl font-semibold text-ink sm:text-2xl">
          No cracked grout. No lifting tile. No surprise bills. Just a licensed crew and tile set
          dead-flat to last in Arizona homes.
        </p>

        <p class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-base font-extrabold text-brand shadow-md ring-1 ring-pop/30 sm:text-lg">
          <span class="h-2.5 w-2.5 rounded-full bg-pop" aria-hidden="true"></span>
          {offer}
        </p>

        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#lead-form"
             class={`zf-sheen rounded-lg bg-pop px-7 py-4 text-center text-lg font-extrabold text-brand-dark shadow-xl sm:text-xl ${btnLift}`}>
            Get My Free Estimate →
          </a>
          <a href={telHref(phones.primary)} data-track-call
             class={`rounded-lg border-2 border-brand/25 bg-white px-7 py-4 text-center text-lg font-extrabold text-brand hover:bg-brand/5 sm:text-xl ${btnLift}`}>
            Call {phone}
          </a>
        </div>

        <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
          <img
            src="/logos/estimate-seal.png"
            alt="Zona Floors free in-home estimate seal — no pressure, no obligation"
            width="220" height="220" loading="eager" decoding="async"
            class="h-20 w-20 drop-shadow-xl sm:h-24 sm:w-24"
          />
          <img
            src="/logos/veteran-seal.png"
            alt="Proud to give veterans, active military, seniors & first responders 10% off"
            width="150" height="150" loading="eager" decoding="async"
            class="h-16 w-16 drop-shadow-xl sm:h-20 sm:w-20"
          />
        </div>

        <!-- FloorDaddy-style checkmark guarantee callouts. -->
        <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap items-center justify-center gap-x-6 gap-y-2">
          {heroGuarantees.map((g) => (
            <li class="inline-flex items-center gap-2 text-sm font-bold text-brand sm:text-base">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-pop text-brand-dark">
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              {g.short}
            </li>
          ))}
        </ul>

        <!-- Trust badge row. -->
        <ul class="mt-7 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
          {siteConfig.badges.map((b) => {
            const logo = LOGO_FILES[b];
            return logo ? (
              <li class="flex h-11 items-center justify-center rounded-lg bg-white px-4 shadow-sm ring-1 ring-black/5">
                <img src={logo.file} alt={`Reviewed on ${b}`} width={logo.w} height={logo.h} loading="eager" decoding="async" class="h-6 w-auto" />
              </li>
            ) : null;
          })}
        </ul>
        <p class="mt-5 text-sm text-brand/60">{ctaMicrocopy}</p>
      </div>

      <!-- Mosaic divider (tile motif). -->
      <div class="tile-frame absolute inset-x-0 bottom-0 h-4" aria-hidden="true"></div>
    </section>

    <!-- ===================== STATS BAND ===================== -->
    <section class="relative bg-gradient-to-br from-brand-dark to-brand text-white">
      <div class="tile-grout pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-14 sm:grid-cols-4 sm:py-16">
        {stats.map((s, i) => (
          <div data-reveal data-reveal-delay={(i % 3) + 1} class="text-center">
            <div class="text-5xl font-extrabold leading-none tracking-tight text-pop sm:text-6xl">
              {s.num}<span class="text-gold">{s.unit}</span>
            </div>
            <div class="mt-2 text-sm font-semibold uppercase tracking-wide text-white/70">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== CREATIVE: patterned tile financing ===================== -->
    <CreativeBanner src={creatives.patterned.src} alt={creatives.patterned.alt} bg="bg-white" />

    <!-- ===================== PRIMARY LEAD FORM ===================== -->
    <section id="lead-form" class="bg-gradient-to-br from-brand-dark to-brand">
      <div data-reveal class="mx-auto max-w-lg px-5 py-14 sm:py-20">
        <div class="overflow-hidden rounded-2xl border-t-4 border-pop shadow-2xl">
          <LeadForm
            slug={SLUG}
            heading="Get your free tile estimate"
            submitLabel="Get My Free Estimate"
            projectLabel="Tile you're considering"
            projectName="tile_type"
            projectOptions={projectOptions}
            privacyNote={privacyNote}
          />
        </div>
      </div>
    </section>

    <!-- ===================== FREE IN-HOME ESTIMATE (showroom-to-your-door) ===================== -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-cta to-cta-dark text-white">
      <span class="pointer-events-none absolute -left-24 -top-24 -z-10 h-72 w-72 rounded-full bg-gold/30 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-28 -right-20 -z-10 h-80 w-80 rounded-full bg-pop/30 blur-3xl" aria-hidden="true"></span>

      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <div data-reveal class="text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-pop px-4 py-1.5 text-sm font-extrabold uppercase tracking-wide text-brand-dark shadow-lg">
            <span aria-hidden="true">🚚</span> No showroom trip required
          </span>
          <h2 class="mx-auto mt-5 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
            We bring the showroom <span class="text-gold">to your door</span>
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-xl text-white/90 sm:text-2xl">
            {offer}. We show up with real tile samples, measure your space, and hand you a clear written price, right there in your kitchen.
          </p>
        </div>

        <ol class="mt-12 grid gap-5 sm:grid-cols-3">
          {[
            { n: "1", icon: "🚪", title: "We come to you", body: "Pick a time that works. Our licensed crew arrives with tile samples in hand, no driving to a store." },
            { n: "2", icon: "🧱", title: "Match it in your light", body: "Lay real porcelain, ceramic & stone-look samples against your walls and your daylight before you commit." },
            { n: "3", icon: "📝", title: "Written price on the spot", body: "Exact measurements, layout & grout advice, and an all-in quote with zero surprises." },
          ].map((s, i) => (
            <li
              data-reveal
              data-reveal-delay={i + 1}
              tabindex="0"
              class={`group relative flex flex-col overflow-hidden rounded-2xl bg-white/10 p-7 text-left ring-1 ring-white/15 backdrop-blur focus:outline-none focus-visible:ring-2 focus-visible:ring-pop ${cardLift} hover:bg-white/15`}
            >
              <span class="absolute right-5 top-4 text-6xl font-extrabold leading-none text-white/10 transition-colors duration-300 group-hover:text-pop/40" aria-hidden="true">{s.n}</span>
              <span class="text-4xl" aria-hidden="true">{s.icon}</span>
              <span class="mt-4 text-2xl font-extrabold text-white sm:text-3xl">{s.title}</span>
              <span class="mt-2 text-lg leading-relaxed text-white/85 sm:text-xl">{s.body}</span>
              <span class="mt-5 block h-1 w-12 origin-left rounded bg-pop transition-all duration-300 group-hover:w-full group-focus-visible:w-full"></span>
            </li>
          ))}
        </ol>

        <div data-reveal class="mt-12 flex flex-col items-center">
          <a href="#lead-form"
             class={`zf-sheen inline-flex items-center gap-2 rounded-lg bg-pop px-8 py-4 text-lg font-extrabold uppercase tracking-wide text-brand-dark shadow-xl sm:text-xl ${btnLift}`}>
            Book My Free Estimate <span aria-hidden="true">→</span>
          </a>
          <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-base text-white/90">
            <span class="inline-flex items-center gap-1.5"><span class="text-gold" aria-hidden="true">★★★★★</span> 5-Star rated</span>
            <span class="text-white/40" aria-hidden="true">·</span>
            <span>Takes about a minute</span>
            <span class="text-white/40" aria-hidden="true">·</span>
            <span>No obligation</span>
          </p>
          <p class="mt-3 text-lg text-white/90">
            Prefer to talk?
            <a href={telHref(phones.primary)} data-track-call class="font-extrabold text-gold underline underline-offset-2 hover:text-white">Call {phone}</a>
            or
            <a href={smsHref(phones.primary)} data-track-sms class="font-extrabold text-gold underline underline-offset-2 hover:text-white">text us</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== GUARANTEES ===================== -->
    <Guarantees
      heading="We put our money where your floor is"
      subhead="Every Zona Floors tile install comes with these guarantees, in writing. No surprises, no games."
    />

    <!-- ===================== CREATIVE: senior + veteran discount ===================== -->
    <CreativeBanner src={creatives.discount.src} alt={creatives.discount.alt} bg="bg-brand/5" />

    <!-- ===================== TILE FEATURES (icon grid) ===================== -->
    <section class="relative bg-white">
      <div class="tile-grout pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <div data-reveal class="text-center">
          <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">Tile floors set to last in Arizona homes</h2>
          <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
          <p class="mx-auto mt-4 max-w-2xl text-xl text-brand/70 sm:text-2xl">
            The difference is everything under the tile, done right the first time.
          </p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {tileFeatures.map((f, i) => (
            <div
              data-reveal
              data-reveal-delay={(i % 3) + 1}
              class={`group rounded-2xl border-2 border-brand/10 bg-white p-6 shadow-sm ${cardLift} hover:border-pop/60`}
            >
              <span class={`flex h-14 w-14 items-center justify-center rounded-xl ${f.tone} text-white shadow-md`}>
                {f.icon === "level" && (
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="9" width="20" height="6" rx="1"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/>
                    <path d="M7 9v6M17 9v6" stroke-linecap="round"/>
                  </svg>
                )}
                {f.icon === "droplet" && (
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M12 3s6 6.5 6 11a6 6 0 11-12 0c0-4.5 6-11 6-11z" stroke-linejoin="round"/>
                  </svg>
                )}
                {f.icon === "grid" && (
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="3" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1"/>
                    <rect x="3" y="13.5" width="7.5" height="7.5" rx="1"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1"/>
                  </svg>
                )}
                {f.icon === "sparkle" && (
                  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2 6 6 2-6 2-2 6-2-6-6-2 6-2z"/>
                  </svg>
                )}
              </span>
              <h3 class="mt-5 text-xl font-extrabold text-brand sm:text-2xl">{f.title}</h3>
              <p class="mt-2 text-lg leading-relaxed text-brand/70 sm:text-xl">{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== CREATIVE: 3-day speed ===================== -->
    <CreativeBanner src={creatives.speed.src} alt={creatives.speed.alt} bg="bg-brand-dark" />

    <!-- ===================== TILE-LOOK SELECTOR ===================== -->
    <section class="bg-gradient-to-b from-white to-brand/5">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <div data-reveal class="text-center">
          <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">Pick your perfect tile 🧱</h2>
          <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
          <p class="mx-auto mt-4 max-w-xl text-xl text-brand/70 sm:text-2xl">
            Tap a look you love and we'll start your quote with it.
          </p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {looks.map((s, i) => (
            <button
              type="button"
              data-species={s.name}
              data-reveal
              data-reveal-delay={i + 1}
              class={`group flex flex-col overflow-hidden rounded-2xl border-2 border-brand/10 bg-white text-left hover:border-pop ${cardLift} ${btnLift}`}
            >
              <span class="relative block aspect-[4/3] overflow-hidden">
                <img
                  src={s.img}
                  alt={`${s.name} tile floor installed by Zona Floors`}
                  width="440"
                  height="330"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <span class="pointer-events-none absolute bottom-3 left-3 inline-flex items-center gap-1.5 rounded-full bg-brand-dark/80 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-white ring-1 ring-white/20">
                  <span aria-hidden="true">🏠</span> Real Zona project
                </span>
              </span>
              <span class="flex grow flex-col p-6">
                <span class="text-2xl font-extrabold text-brand sm:text-3xl">{s.name}</span>
                <span class="mt-1 text-lg text-brand/70 sm:text-xl">{s.note}</span>
                <span class="mt-4 text-lg font-bold text-pop sm:text-xl">
                  Start with {s.name}
                  <span class="inline-block transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"> →</span>
                </span>
              </span>
            </button>
          ))}
        </div>

        <p class="mx-auto mt-8 max-w-2xl text-center text-xl text-brand/70 sm:text-2xl">
          Can't decide? That's exactly what we're here for. We'll help you choose during your free in-home estimate.
        </p>
      </div>
    </section>

    <!-- ===================== CREATIVE: 0% financing ===================== -->
    <CreativeBanner src={creatives.financing.src} alt={creatives.financing.alt} bg="bg-brand/5" />

    <!-- ===================== SPLIT FEATURE (asymmetric) ===================== -->
    <section class="overflow-hidden bg-white">
