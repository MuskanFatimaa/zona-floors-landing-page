<script>
  import { trackConversion } from "@/lib/tracking";
  import { initReveal } from "@/lib/reveal";

  // Scroll-reveal (no-op under prefers-reduced-motion).
  initReveal();

  // ---- A/B heading variant (?v=a|b|c) ----
  // Control (A) is server-rendered; B/C swap in here. The active variant is
  // posted with every lead and tagged to Clarity so wins are attributable.
  (function heroVariant() {
    const requested = (new URLSearchParams(location.search).get("v") || "a").toLowerCase();
    let variants: Record<string, { pre: string; accent: string; post: string; sub: string }> = {};
    try { variants = JSON.parse(document.getElementById("hero-variants")?.textContent || "{}"); } catch { /* keep control */ }
    const variant = variants[requested] ? requested : "a";

    if (variant !== "a") {
      const v = variants[variant];
      const set = (sel: string, text: string) => { const el = document.querySelector<HTMLElement>(sel); if (el) el.textContent = text; };
      set("[data-h1-pre]", v.pre);
      set("[data-h1-accent]", v.accent);
      set("[data-h1-post]", v.post);
      set("[data-hero-sub]", v.sub);
    }
    document.documentElement.dataset.heroVariant = variant;

    // Attribute the variant to every lead.
    document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
      const input = document.createElement("input");
      input.type = "hidden";
      input.name = "heading_variant";
      input.value = variant;
      form.appendChild(input);
    });

    // Tag analytics (Clarity) if present.
    (window as unknown as { clarity?: (...a: unknown[]) => void }).clarity?.("set", "heading_variant", variant);
  })();

  // ---- Stats count-up on scroll (skips ranges like "3-7"; respects reduced motion) ----
  (function countUp() {
    const reduce = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
    const isNum = (s: string) => /^\d+(\.\d+)?$/.test(s);
    const counters = Array.from(document.querySelectorAll<HTMLElement>("[data-countup]"))
      .filter((el) => isNum(el.dataset.countup || ""));
    if (reduce || typeof IntersectionObserver === "undefined" || counters.length === 0) return;

    const run = (el: HTMLElement) => {
      const target = el.dataset.countup || "";
      const to = parseFloat(target);
      const decimals = (target.split(".")[1] || "").length;
      const dur = 1100;
      let startTs = 0;
      const tick = (now: number) => {
        if (!startTs) startTs = now;
        const p = Math.min(1, (now - startTs) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = (to * eased).toFixed(decimals);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = target;
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver((entries, obs) => {
      for (const e of entries) {
        if (e.isIntersecting) { run(e.target as HTMLElement); obs.unobserve(e.target); }
      }
    }, { threshold: 0.4 });
    counters.forEach((c) => { c.textContent = "0"; io.observe(c); });
  })();

  // tel: / sms: conversion tracking.
  document.querySelectorAll<HTMLAnchorElement>("[data-track-call]").forEach((el) =>
    el.addEventListener("click", () => trackConversion("call")));
  document.querySelectorAll<HTMLAnchorElement>("[data-track-sms]").forEach((el) =>
    el.addEventListener("click", () => trackConversion("sms")));

  // LVP-look selector → pre-select the lead form's dropdown, then jump to it.
  const select = document.querySelector<HTMLSelectElement>("[data-project-select]");
  document.querySelectorAll<HTMLButtonElement>("[data-species]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const value = btn.dataset.species ?? "";
      if (select && value) {
        if (!Array.from(select.options).some((o) => o.value === value)) {
          select.add(new Option(value, value));
        }
        select.value = value;
      }
      document.getElementById("lead-form")?.scrollIntoView({ behavior: "smooth" });
    }));
</script>
