---
/**
 * /vinyl-plank-flooring, Luxury Vinyl Plank (LVP) Installation landing page (Google Ads).
 *
 * THIRD distinct visual identity (wood = serif/gold, tile = Bricolage/pink):
 * vinyl = Sora + Plus Jakarta Sans on a slate/charcoal base with an electric-blue
 * NEON pop, plank-seam motifs, a pulsing neon glow + a scrolling marquee offer
 * ticker. All scoped to .vinyl-theme (see global.css); the wood/tile pages are
 * untouched.
 *
 * Message-matched to the vinyl ad group ("Vinyl Plank Flooring", "Luxury Vinyl
 * Plank Install", "Waterproof LVP Flooring").
 *
 * Client-branded vinyl promo creatives + a real before/after pair are now
 * supplied (under /creatives/vinyl) and used via <CreativeBanner>/<BeforeAfter>.
 * NO vinyl-specific reviews on record -> general verbatim Google reviews only
 * (never fabricated).
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import LeadForm from "@/components/LeadForm.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import Guarantees from "@/components/Guarantees.astro";
import CreativeBanner from "@/components/CreativeBanner.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import { siteConfig, approvedOffers, approvedGuarantees, readyReviews } from "@/lib/siteConfig";
import { formatPhone, telHref, smsHref } from "@/lib/phone";

const SLUG = "vinyl-plank-flooring";
const { phones, business, serviceArea } = siteConfig;
const phone = formatPhone(phones.primary);
const offer = approvedOffers()[0]?.text ?? "";

const metro = "Phoenix & the East Valley";

// A/B-testable hero headings. Each follows a proven local-service conversion
// pattern (authority, benefit, offer) and every variant contains the primary
// keyword "Vinyl Plank Flooring" + a Phoenix location (CLAUDE.md #5: one H1,
// keyword + location). Variant A is the server-rendered CONTROL (keeps the
// mobile gate green). A visitor lands on a variant via ?v=a|b|c (read client-
// side below); the active variant is posted with every lead (heading_variant)
// and tagged to Clarity so conversions are attributed to the heading that won.
const headingVariants = {
  a: {
    pre: "Vinyl Plank Flooring in", accent: "Phoenix & the East Valley", post: "",
    sub: "Waterproof, scratch-proof, and installed dead-flat by a licensed local crew.",
  },
  b: {
    pre: "Phoenix's Waterproof", accent: "Vinyl Plank Flooring", post: "Pros",
    sub: "Floors tough enough for kids, pets, and Arizona summers.",
  },
  c: {
    pre: "Get Waterproof", accent: "Vinyl Plank Flooring", post: "in Phoenix",
    sub: "Free in-home estimate. Most jobs done in just 3 to 7 days.",
  },
};
const heroVariant = headingVariants.a;

// Snappy, scannable hero value-prop chips (icons rendered via set:html).
const valueProps = [
  { label: "100% Waterproof", icon: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 11-12 0c0-4.5 6-11 6-11z" stroke-linejoin="round"/></svg>' },
  { label: "Pet & kid proof", icon: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>' },
  { label: "Done in 3 to 7 days", icon: '<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke-linejoin="round"/></svg>' },
];

// Real Zona LVP project photos (client-supplied, watermark removed + optimized
// -> /creatives/vinyl).
const img = {
  hero: "/creatives/vinyl/hero.jpg",            // fully furnished bedroom on grey wood-look LVP
  hall: "/creatives/vinyl/hall.jpg",            // low-angle hallway, grey wood-look LVP detail
  greatRoom: "/creatives/vinyl/great-room.jpg", // great room with bookshelves, wood-look LVP
  lightPlank: "/creatives/vinyl/light-plank.jpg", // light wood-look LVP plank detail
  team: "/creatives/vinyl/team.jpg",            // a Zona Team installer click-locking a plank
  pet: "/creatives/vinyl/pet.jpg",              // puppy napping on LVP (pet-proof proof shot)
  toddler: "/creatives/vinyl/toddler.jpg",      // toddler crayons & toys on LVP (kid-proof)
};

// Client-branded vinyl promo creatives (square, baked-in CTAs). Distributed
// across the page; each links to the lead form via <CreativeBanner>.
const creatives = {
  dream:    { src: "/creatives/vinyl/ad-creative-1.jpg", alt: "Dream flooring for your dream bedroom. 0% financing available and 10% off for veterans. Book a free estimate today." },
  senior:   { src: "/creatives/vinyl/ad-creative-2.jpg", alt: "Senior discounts on all flooring jobs, plus a thank-you discount for veterans. Book a free estimate today." },
  speed3:   { src: "/creatives/vinyl/ad-creative-3.jpg", alt: "New vinyl floors in 3 days, with 10% off for veterans and seniors. Get a free quote today." },
  giveback: { src: "/creatives/vinyl/ad-creative-4.jpg", alt: "Floors done in 3 days, free in-home estimation, and 10% off for military, seniors and first responders. Zona Floors gives back." },
  carpet:   { src: "/creatives/vinyl/ad-creative-5.jpg", alt: "Sick of your old, worn out carpet? Get new floors in 3 days. Before and after, with 10% off for veterans." },
};

// Real before/after pair (same bedroom: old carpet -> furnished LVP). Branded
// BEFORE/AFTER labels + logo are baked into the squares.
const beforeAfter = { before: "/creatives/vinyl/before.jpg", after: "/creatives/vinyl/after.jpg" };

// FAQ, lead-friction reducers, written from approved intake facts + category truths only.
const faqs = [
  { q: "Is luxury vinyl plank really waterproof?", a: "Yes. Quality LVP has a waterproof core, which is exactly why it belongs in Arizona kitchens, baths, and laundry rooms. We still moisture-test and prep the subfloor first so it performs for years, not just on day one." },
  { q: "Can you install vinyl plank over my existing tile or concrete?", a: "Often, yes. Floating click-lock planks can go over many existing hard surfaces. We check the subfloor during your free estimate, level any low or high spots, and tell you straight, in writing, whether yours needs prep or removal first." },
  { q: "Will vinyl plank hold up to pets, kids, and heavy traffic?", a: "That's where LVP shines. A tough wear layer shrugs off pet nails, dropped toys, and busy-family traffic, so it keeps looking new far longer than you'd expect." },
  { q: "How much does vinyl plank installation cost?", a: "Every home is different, so you get a clear written price at a free in-home estimate, honest up-front pricing, and a price-match guarantee. The estimate is the price. Quality flooring installed from as low as $2.40 per square foot on qualifying jobs; ask us for details." },
  { q: "How long does a vinyl floor take?", a: "Most projects are completed in just 3 to 7 days, depending on size and prep. You'll get a firm timeline with your written quote." },
  { q: "Are you licensed and insured?", a: `Yes. We're a licensed Arizona contractor (${business.license.number}), locally owned, with our own installers on every job, never day-labor subs.` },
];

// Three short guarantee callouts for the hero (checkmark row, desktop only).
const heroGuarantees = approvedGuarantees().filter((g) =>
  ["warranty", "upfront", "price-match"].includes(g.key),
);

// Real, non-fabricated figures for the stats band.
const stats = [
  { num: "4.9", unit: "★", label: "Google rating" },
  { num: "103", unit: "+", label: "Google reviews" },
  { num: "24", unit: "mo", label: "Workmanship warranty" },
  { num: "3-7", unit: "", label: "Day installs" },
];

// LVP-specific craft strengths, each with a relevant icon (rendered below).
const vinylFeatures = [
  { icon: "droplet", tone: "bg-pop",   title: "100% waterproof core",      body: "Spills, pet accidents, and humidity won't faze it. A waterproof core means LVP belongs in kitchens, baths, and laundry rooms." },
  { icon: "shield",  tone: "bg-cta",   title: "Scratch & dent resistant",  body: "A tough wear layer shrugs off pet nails, furniture, and busy-family traffic, so it still looks new years from now." },
  { icon: "level",   tone: "bg-brand", title: "Dead-flat subfloor prep",   body: "We moisture-test and level the subfloor first, so planks never peak, gap, or telegraph every bump underneath." },
  { icon: "comfort", tone: "bg-gold",  title: "Quieter, warmer underfoot", body: "Engineered planks with the right underlayment soften footsteps and feel warmer than tile on cool desert mornings." },
];

const steps = [
  { title: "Free in-home estimate", body: "We measure, talk colors, plank width & layout, and give you a clear written quote." },
  { title: "Moisture-test & level", body: "We check the subfloor for moisture, then level it flat before a single plank goes down." },
  { title: "Click-lock install & finish", body: "Tight, staggered planks, clean transitions and trim, then we walk the floor with you." },
];

// Interactive look selector using real Zona LVP projects. Clicking a card
// pre-selects it in the lead form (shared script at the bottom).
const looks = [
  { name: "Light wood-look", note: "Bright, airy, easy to match", img: img.lightPlank },
  { name: "Cool grey plank", note: "Modern, clean, on-trend", img: img.hall },
  { name: "Greige wood-look", note: "Soft, contemporary depth", img: img.greatRoom },
];

const projectOptions = ["SPC / rigid core (waterproof)", "Waterproof wood-look", "Stone & concrete look", "Glue-down LVP", "Other / not sure"];

// Social proof, REAL verbatim Google reviews. No vinyl-specific reviews on record,
// so use product-neutral general reviews (never a fabricated vinyl quote).
const fmtName = (n: string) => {
  const [first, second] = n.trim().split(/\s+/);
  return second ? `${first} ${second[0]}.` : first;
};
const proof = readyReviews("general")
  .slice(0, 5)
  .map((r) => ({ name: fmtName(r.name), note: r.verbatim }));

const LOGO_FILES: Record<string, { file: string; w: number; h: number }> = {
  Google: { file: "/logos/google.svg", w: 28, h: 28 },
  Yelp: { file: "/logos/yelp.svg", w: 28, h: 28 },
  Angi: { file: "/logos/angi-sm.png", w: 46, h: 28 },
  BBB: { file: "/logos/bbbsvg.svg", w: 16, h: 28 },
  Nextdoor: { file: "/logos/nextdoor.svg", w: 28, h: 28 },
};

const ctaMicrocopy = `Licensed ${business.license.number} · Locally owned · No pressure, ever`;
const privacyNote = "Your info goes straight to our team. No spam, no third parties.";

const btnLift =
  "transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pop/70 focus-visible:ring-offset-2";
const cardLift = "transition-all duration-200 hover:-translate-y-1 hover:shadow-lg";

// Offer ticker items (marquee). Two copies are rendered in the markup for a
// seamless -50% loop.
const tickerItems = [
  "100% waterproof luxury vinyl plank",
  "0% financing for 12 months",
  "10% off veterans, seniors & first responders",
  "Free in-home estimate",
  "Most installs done in 3 to 7 days",
];
---

<Layout
  title="Vinyl Plank Flooring in Phoenix & the East Valley | Zona Floors"
  description="Waterproof luxury vinyl plank (LVP) installation by a licensed, locally-owned Arizona crew. Scratch-resistant, pet-proof, installed dead-flat. Free in-home estimate."
>
  <Header />

  <main class="vinyl-theme">
    <!-- ===================== MARQUEE OFFER RIBBON ===================== -->
    <a href="#lead-form" class="zf-marquee-wrap group block overflow-hidden border-y border-pop/40 bg-brand-dark py-2 text-white">
      <div class="zf-marquee" aria-hidden="true">
        {[0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {tickerItems.map((t) => (
              <li class="flex items-center whitespace-nowrap px-6 text-sm font-extrabold uppercase tracking-wide">
                <span class="mr-3 text-pop">◆</span>{t}
              </li>
            ))}
          </ul>
        ))}
      </div>
      <span class="sr-only">Waterproof luxury vinyl plank, 0% financing for 12 months, 10% off veterans and seniors, free in-home estimate, most installs done in 3 to 7 days. Book now.</span>
    </a>

    <!-- ===================== HERO (full-bleed bedroom bg, slate + neon) ===================== -->
    <section class="relative isolate overflow-hidden bg-brand-dark text-white">
      <!-- Furnished-bedroom hero photo as the full-bleed background. -->
      <img
        src={img.hero}
        alt="Fully furnished bedroom with warm grey wood-look luxury vinyl plank flooring installed by Zona Floors"
        fetchpriority="high" loading="eager" decoding="async"
        width="1400" height="1867" sizes="100vw"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
      />
      <!-- Lighter slate overlays so more of the photo shows while white text stays legible. -->
      <div class="absolute inset-0 -z-10 bg-brand-dark/35" aria-hidden="true"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-dark/85 via-brand-dark/45 to-transparent" aria-hidden="true"></div>
      <div class="plank-lines pointer-events-none absolute inset-0 -z-10 opacity-30" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-6xl px-5 pb-12 pt-8 sm:pt-10 lg:pb-24">
        <!-- Copy block. -->
        <div class="max-w-2xl">
          <p data-reveal class="inline-flex flex-col items-start gap-1 rounded-2xl bg-white/10 px-4 py-2 text-sm font-bold text-white ring-1 ring-white/15 backdrop-blur sm:flex-row sm:items-center sm:gap-2 sm:rounded-full">
            <span class="text-base leading-none text-gold" aria-hidden="true">★★★★★</span>
            <span class="inline-flex items-center gap-1.5">
              <img src="/logos/google.svg" alt="Google" width="18" height="18" class="h-4 w-4" />
              5-Star Rated on Google · 4.9 · 103+ reviews
            </span>
          </p>

          <h1 class="mt-5 text-3xl font-extrabold leading-[1.04] sm:text-5xl" data-h1>
            <span data-h1-pre>{heroVariant.pre}</span>
            <span class="text-pop" data-h1-accent>{heroVariant.accent}</span>
            <span data-h1-post>{heroVariant.post}</span>
          </h1>
          <p class="mt-4 max-w-md text-lg font-semibold text-white/85 sm:text-xl" data-hero-sub>{heroVariant.sub}</p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#lead-form"
               class={`zf-sheen rounded-lg bg-pop px-7 py-4 text-center text-lg font-extrabold text-brand-dark shadow-xl sm:text-xl ${btnLift}`}>
              Get My Free Estimate →
            </a>
            <a href={telHref(phones.primary)} data-track-call
               class={`flex items-center justify-center gap-2 rounded-lg border-2 border-white/25 bg-white/5 px-7 py-4 text-center text-lg font-extrabold text-white hover:bg-white/10 sm:text-xl ${btnLift}`}>
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 5.5C3 14 10 21 18.5 21a2 2 0 002-1.7l.3-2a1.5 1.5 0 00-1-1.6l-3-1a1.5 1.5 0 00-1.6.4l-1 1a12 12 0 01-4.7-4.7l1-1a1.5 1.5 0 00.4-1.6l-1-3A1.5 1.5 0 005.2 3l-2 .3A2 2 0 003 5.5z" stroke-linejoin="round"/></svg>
              Call {phone}
            </a>
          </div>

          <!-- Offer / estimate-seal trust row (kept above the mobile fold). -->
          <div class="mt-6 flex items-center gap-3">
            <img
              src="/logos/estimate-seal.png"
              alt="Zona Floors free in-home estimate seal, no pressure, no obligation"
              width="220" height="220" loading="eager" decoding="async"
              class="h-16 w-16 shrink-0 drop-shadow-lg sm:h-20 sm:w-20"
            />
            <p class="text-base font-semibold text-white/85 sm:text-lg">
              Free in-home estimate. We bring the samples to you, no pressure, no obligation.
            </p>
          </div>

          <!-- Snappy value-prop chips (icons). -->
          <ul class="mt-5 flex flex-wrap gap-2">
            {valueProps.map((vp, i) => (
              <li data-reveal data-reveal-delay={(i % 3) + 1} class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-bold text-white ring-1 ring-white/15 backdrop-blur">
                <span class="text-pop" set:html={vp.icon}></span>
                {vp.label}
              </li>
            ))}
          </ul>

          <!-- Checkmark guarantee callouts (desktop only, keeps mobile hero compact). -->
          <ul class="mt-7 hidden max-w-xl flex-wrap items-center gap-x-6 gap-y-2 sm:flex">
            {heroGuarantees.map((g) => (
              <li class="inline-flex items-center gap-2 text-sm font-bold text-white sm:text-base">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-pop text-brand-dark">
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" aria-hidden="true">
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                {g.short}
              </li>
            ))}
          </ul>

          <!-- Trust badge row. -->
          <ul class="mt-7 flex flex-wrap items-center gap-2.5 sm:gap-3">
            {siteConfig.badges.map((b) => {
              const logo = LOGO_FILES[b];
              return logo ? (
                <li class="flex h-11 items-center justify-center rounded-lg bg-white px-4 shadow-sm ring-1 ring-black/5">
                  <img src={logo.file} alt={`Reviewed on ${b}`} width={logo.w} height={logo.h} loading="eager" decoding="async" class="h-6 w-auto" />
                </li>
              ) : null;
            })}
          </ul>
          <p class="mt-5 text-sm text-white/55">{ctaMicrocopy}</p>
        </div>

      </div>

      <!-- Floating waterproof badge over the bedroom photo (desktop). -->
      <span class="zf-bob absolute bottom-10 right-8 -rotate-2 hidden items-center gap-2 rounded-lg bg-pop px-4 py-2 text-base font-extrabold uppercase tracking-wide text-brand-dark shadow-xl ring-2 ring-brand-dark lg:inline-flex">
        <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-dark/60"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-dark"></span>
        </span>
        100% Waterproof
      </span>

      <div class="plank-bar absolute inset-x-0 bottom-0 h-1" aria-hidden="true"></div>
    </section>

    <!-- ===================== LOGOS TRUST STRIP ===================== -->
    <section class="border-b border-brand/10 bg-white">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-5 py-6 sm:flex-row sm:justify-center sm:gap-8">
        <p class="text-sm font-extrabold uppercase tracking-[0.15em] text-brand/60">
          <span class="text-gold" aria-hidden="true">★★★★★</span> Rated 5 stars across
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-4">
          {siteConfig.badges.map((b) => {
            const logo = LOGO_FILES[b];
            return logo ? (
              <li class="flex items-center">
                <img
                  src={logo.file}
                  alt={`Reviewed on ${b}`}
                  width={logo.w}
                  height={logo.h}
                  loading="eager"
                  decoding="async"
                  class="h-7 w-auto transition-transform duration-300 hover:-translate-y-0.5 hover:scale-105"
                />
              </li>
            ) : null;
          })}
        </ul>
      </div>
    </section>

    <!-- ===================== RECENT PROJECTS ===================== -->
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <div data-reveal class="mx-auto max-w-2xl text-center">
          <span class="text-sm font-extrabold uppercase tracking-[0.2em] text-cta">Recent projects</span>
          <h2 class="mt-3 text-3xl font-extrabold text-brand sm:text-4xl">Vinyl plank installs across the Valley</h2>
          <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
          <p class="mt-4 text-xl text-brand/70 sm:text-2xl">Real Zona Floors LVP projects, waterproof and built to last.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-3">
          {[
            { src: img.hero, label: "Furnished bedroom retreat" },
            { src: img.greatRoom, label: "Wood-look LVP great room" },
            { src: img.hall, label: "Seamless plank hallway" },
          ].map((p, i) => (
            <a
              href="#lead-form"
              data-reveal
              data-reveal-delay={i + 1}
              class={`group relative block overflow-hidden rounded-2xl shadow-xl ring-1 ring-black/10 ${btnLift}`}
            >
              <img
                src={p.src}
                alt={`Finished Zona Floors vinyl plank project, ${p.label}`}
                width="600" height="800" loading="lazy" decoding="async"
                class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-dark/85 to-transparent p-5 pt-14 text-left">
                <span class="text-lg font-extrabold text-white sm:text-xl">{p.label}</span>
              </figcaption>
            </a>
          ))}
        </div>
        <div data-reveal class="mt-10 text-center">
          <a href="#lead-form" class={`zf-sheen inline-block rounded-lg bg-pop px-7 py-4 text-lg font-extrabold text-brand-dark shadow-lg sm:text-xl ${btnLift}`}>
            Get your free estimate →
          </a>
        </div>
      </div>
    </section>

    <!-- ===================== STATS BAND ===================== -->
    <section class="relative bg-gradient-to-br from-brand-dark to-brand text-white">
      <div class="plank-lines pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 px-5 py-14 sm:grid-cols-4 sm:py-16">
        {stats.map((s, i) => (
          <div data-reveal data-reveal-delay={(i % 3) + 1} class="text-center">
            <div class="text-5xl font-extrabold leading-none tracking-tight text-pop sm:text-6xl">
              <span data-countup={s.num}>{s.num}</span><span class="text-gold">{s.unit}</span>
            </div>
            <div class="mt-2 text-sm font-semibold uppercase tracking-wide text-white/70">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== CREATIVE: dream bedroom / 0% financing ===================== -->
    <CreativeBanner src={creatives.dream.src} alt={creatives.dream.alt} bg="bg-brand-dark" />

    <!-- ===================== PRIMARY LEAD FORM ===================== -->
    <section id="lead-form" class="bg-gradient-to-br from-brand-dark to-brand">
      <div data-reveal class="mx-auto max-w-lg px-5 py-14 sm:py-20">
        <div class="overflow-hidden rounded-2xl border-t-4 border-pop shadow-2xl">
          <LeadForm
            slug={SLUG}
            heading="Get your free vinyl plank estimate"
            submitLabel="Get My Free Estimate"
            projectLabel="Vinyl you're considering"
            projectName="vinyl_type"
            projectOptions={projectOptions}
            privacyNote={privacyNote}
          />
        </div>
      </div>
    </section>

    <!-- ===================== FREE IN-HOME ESTIMATE (showroom-to-your-door) ===================== -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-cta to-cta-dark text-white">
      <span class="pointer-events-none absolute -left-24 -top-24 -z-10 h-72 w-72 rounded-full bg-gold/25 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-28 -right-20 -z-10 h-80 w-80 rounded-full bg-pop/30 blur-3xl" aria-hidden="true"></span>

      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <div data-reveal class="text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-pop px-4 py-1.5 text-sm font-extrabold uppercase tracking-wide text-brand-dark shadow-lg">
            <span aria-hidden="true">🚚</span> No showroom trip required
          </span>
          <h2 class="mx-auto mt-5 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
