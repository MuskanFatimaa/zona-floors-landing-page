---
/**
 * /terms — baseline terms of use (NAP from config).
 * NOTE: have the client's counsel review before launch.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { siteConfig } from "@/lib/siteConfig";

const { business } = siteConfig;
const effective = new Date().toISOString().slice(0, 10);
---

<Layout title={`Terms of Use — ${business.displayName}`}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12 text-brand/90">
    <h1 class="text-3xl font-extrabold text-brand">Terms of Use</h1>
    <p class="mt-2 text-sm text-brand/60">Effective {effective}</p>

    <div class="mt-6 space-y-5 text-lg leading-relaxed">
      <p>
        These terms govern your use of this website operated by {business.legalName},
        licensed under {business.license.number} ({business.license.issuingBody}).
      </p>

      <h2 class="text-2xl font-bold text-brand">Quotes and estimates</h2>
      <p>
        Information on this site is for general purposes only and does not constitute a
        binding quote. Pricing, availability, and project timelines are confirmed in a
        written estimate after an in-person or virtual assessment.
      </p>

      <h2 class="text-2xl font-bold text-brand">Use of the site</h2>
      <p>
        You agree to provide accurate information when contacting us and not to misuse
        the site or its forms. We may update these terms at any time; continued use
        constitutes acceptance of the current version.
      </p>

      <h2 class="text-2xl font-bold text-brand">Limitation of liability</h2>
      <p>
        The site is provided “as is.” To the fullest extent permitted by law,
        {business.legalName} is not liable for any indirect or incidental damages
        arising from use of this website.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
