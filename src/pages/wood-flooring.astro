---
/**
 * /wood-flooring, Hardwood Flooring Installation landing page (Google Ads).
 *
 * Message-matched to the hardwood ad group headlines: "Hardwood Flooring
 * Experts", "Expert installation for solid and engineered hardwood floors",
 * "Get a free project quote", "Licensed, insured, and locally owned in
 * Arizona", "Expert Wood Floor Acclimation", "precision craftsmanship".
 *
 * DATA STILL PENDING (intake, NOT fabricated here; layout is built to accept it):
 *   - aggregate rating + count  → qualitative "5-Star Rated on Google" only;
 *     numeric rating renders only once siteConfig supplies it.
 *   - verbatim Google review text + reviewer cities → cards show attributed
 *     paraphrases, clearly labelled as highlights, not quotes.
 *   - speed-to-lead promise     → intentionally absent (rule #3).
 *   - exact offer wording       → free in-home estimate (ad-supported, flagged
 *     pending final client sign-off in siteConfig).
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileBar from "@/components/StickyMobileBar.astro";
import LeadForm from "@/components/LeadForm.astro";
import ProcessSteps from "@/components/ProcessSteps.astro";
import ProblemSolution from "@/components/ProblemSolution.astro";
import ProjectGallery from "@/components/ProjectGallery.astro";
import BeforeAfter from "@/components/BeforeAfter.astro";
import Guarantees from "@/components/Guarantees.astro";
import CreativeBanner from "@/components/CreativeBanner.astro";
import { siteConfig, approvedOffers, readyReviews } from "@/lib/siteConfig";
import { formatPhone, telHref, smsHref } from "@/lib/phone";

const SLUG = "wood-flooring";
const { phones, photos, business, serviceArea } = siteConfig;
const phone = formatPhone(phones.primary);
const offer = approvedOffers()[0]?.text ?? "";

const metro = "Phoenix & the East Valley";

// Hero background, client-supplied photo, watermark removed + web-optimized
// (see scripts that produced /creatives/hero.jpg from the raw hero.png).
const heroImg = "/creatives/hardwood/hero.jpg";

// Client-branded promo creatives (self-hosted under /public/creatives). Each is a
// square sales graphic with a baked-in "Get Free Quote" CTA; rendered as a
// clickable CreativeBanner that jumps to the lead form so it actually converts.
const creatives = {
  pricing:   { src: "/creatives/hardwood/c1.jpg", alt: "Zona Floors hardwood with honest up-front pricing: the price we quote is the price you pay" },
  financing: { src: "/creatives/hardwood/c2.jpg", alt: "New floors with 0% interest financing for 12 months, before and after" },
  speed:     { src: "/creatives/hardwood/c7.jpg", alt: "Bored of your old grey carpet? Get new floors in 3 days. Before and after, with 10% off for veterans." },
  trust:     { src: "/creatives/hardwood/c4.jpg", alt: "Local Phoenix Valley flooring contractors: real work, real accountability" },
  discount:  { src: "/creatives/hardwood/c9.jpg", alt: "Senior discounts on all flooring jobs, plus a thank-you discount for veterans. Book a free estimate today." },
  // Top-of-page lead-getters (highest-converting client creatives). Each is a
  // square sales graphic with a baked-in CTA; rendered as a clickable card to #lead-form.
  speed3day: { src: "/creatives/hardwood/c5.jpg", alt: "New hardwood floors in 3 days, with 10% off for veterans and seniors. Book a free estimate today." },
  finance12: { src: "/creatives/hardwood/7.jpg", alt: "0% financing for 12 months on new hardwood floors, with 10% off for veterans and seniors." },
};

// Real intake photo for the asymmetric split feature.
const featureImg = photos.hardwood[0];

// Real, non-fabricated figures for the stats band.
const stats = [
  { num: "4.9", unit: "★", label: "Google rating" },
  { num: "103", unit: "+", label: "Google reviews" },
  { num: "24", unit: "mo", label: "Labor warranty" },
  { num: "3-7", unit: "", label: "Day installs" },
];

// What sets Zona apart (heading shows a Zona quality, not a problem).
// Each card = one craft strength, one tight line.
const strengths = [
  {
    problem: "Every plank acclimated in your home",
    solution: "3 to 7 days to match your indoor air, so floors stay flat and gap-free in the desert.",
  },
  {
    problem: "Moisture-tested slabs",
    solution: "We meter the slab and set the right vapor barrier before a single board goes down.",
  },
  {
    problem: "Flattened, silent subfloors",
    solution: "No rocking, no hollow spots, no squeaks underfoot, ever.",
  },
  {
    problem: "Honest solid-vs-engineered advice",
    solution: "We spec the floor that lasts in your home, never an upsell.",
  },
];

const steps = [
  { title: "Free in-home estimate", body: "We measure, talk solid vs. engineered, and give you a clear written quote." },
  { title: "Prep & acclimate", body: "Moisture-test, flatten the subfloor, and let your hardwood adjust to your home." },
  { title: "Precision install & walkthrough", body: "Tight seams, clean transitions, then we walk the finished floor with you." },
];

const galleryPhotos = [
  { src: photos.hardwood[0], label: "Recent hardwood installation" },
  { src: photos.hardwood[1], label: "Engineered hardwood, bathroom remodel" },
  { src: photos.hardwood[2], label: "Tight seams and clean plank transitions" },
  { src: photos.hardwood[3], label: "Wide-plank wood flooring" },
  { src: photos.hardwood[4], label: "Hardwood throughout the main floor" },
];

// Interactive species selector. Clicking a card pre-selects it in the lead form.
// Descriptors are generic wood-species facts, not internal sales claims.
// Species swatch imagery supplied by client in /public/images.
// Each card auto-crossfades between the wood swatch and a real Zona crew install
// photo (watermark-removed + optimized under /public/images), and shows the crew
// shot on hover. Crew photos client-supplied 2026-06-17.
const species = [
  { name: "White Oak", note: "Timeless & hard-wearing", img: "/images/whiteoak.jpg", crew: "/images/zona-whiteoak.jpg" },
  { name: "Walnut", note: "Rich, premium tones", img: "/images/walnut.jpg", crew: "/images/zona-walnut.jpg" },
  { name: "Maple", note: "Warm & budget-friendly", img: "/images/maple.jpg", crew: "/images/zona-maple.jpg" },
];

const ba = siteConfig.beforeAfter;
const projectOptions = ["White Oak", "Walnut", "Maple", "Engineered hardwood", "Other / not sure"];

// Team-at-work photos (real job-site photos from intake).
const teamPhotos = photos.team.slice(0, 3);

// Social proof, REAL verbatim Google reviews (siteConfig, confirmed 2026-06-17).
// Hardwood-specific first, then general crew reviews. Names shown first-name +
// last initial only (intake: first names only, no cities on record).
const fmtName = (n: string) => {
  const [first, second] = n.trim().split(/\s+/);
  return second ? `${first} ${second[0]}.` : first;
};
const proof = [...readyReviews("hardwood"), ...readyReviews("general")]
  .slice(0, 4)
  .map((r) => ({ name: fmtName(r.name), note: r.verbatim }));

// Real review-platform logos. Config (siteConfig.badges) is the source of which
// platforms; this map carries the rendering asset + intrinsic ratio (for CLS).
// Angi (.png) and BBB (.svg) supplied by the client; the rest are official marks.
const LOGO_FILES: Record<string, { file: string; w: number; h: number }> = {
  Google: { file: "/logos/google.svg", w: 28, h: 28 },
  Yelp: { file: "/logos/yelp.svg", w: 28, h: 28 },
  Angi: { file: "/logos/angi.png", w: 46, h: 28 },
  BBB: { file: "/logos/bbbsvg.svg", w: 16, h: 28 },
  Nextdoor: { file: "/logos/nextdoor.svg", w: 28, h: 28 },
};

const ctaMicrocopy = `Licensed ${business.license.number} · Locally owned · No pressure, ever`;
const privacyNote = "Your info goes straight to our team. No spam, no third parties.";

// Shared interaction class strings (consistent micro-interactions, no JS).
const btnLift =
  "transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/70 focus-visible:ring-offset-2";
const cardLift = "transition-all duration-200 hover:-translate-y-1 hover:shadow-lg";
---

<Layout
  title="Hardwood Floor Installation in Phoenix & the East Valley | Zona Floors"
  description="Expert solid & engineered hardwood floor installation. Licensed, insured, locally-owned Arizona crew. Free in-home estimate. Call or request a quote."
>
  <Header />

  <main>
    <!-- ===================== HERO ===================== -->
    <section class="relative isolate overflow-hidden text-white">
      <!-- Full-bleed finished-install photo (LCP image, priority-loaded). -->
      <img
        src={heroImg}
        alt="Finished hardwood floor installed by Zona Floors"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="1600"
        height="893"
        sizes="100vw"
        class="zf-kenburns absolute inset-0 -z-10 h-full w-full object-cover"
      />
      <!-- Light, top-anchored scrim: darker behind the copy, clearing toward the
           foreground so the actual hardwood floor stays visible. Text-shadow
           (on the content) carries the rest of the legibility. -->
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-dark/55 via-brand-dark/25 to-brand-dark/5"></div>

      <div class="text-shadow-strong mx-auto max-w-6xl px-5 pb-16 pt-8 sm:pt-12">
        <p class="flex flex-col items-start gap-y-1 text-base font-semibold sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2 sm:gap-y-0.5 sm:text-lg">
          <span class="text-gold" aria-hidden="true">★★★★★</span>
          <span>5-Star Rated on Google</span>
        </p>
        <span class="mt-3 block h-px w-12 bg-gold/70"></span>

        <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
          Hardwood Floor Installation in <span class="text-gold">{metro}</span>
        </h1>
        <p class="mt-4 max-w-2xl text-xl font-medium text-white sm:text-2xl">
          No-show contractors? Surprise bills? Not here. Licensed hardwood floor installation,
          built to stay flat and gap-free in the Arizona desert.
        </p>

        <div class="mt-6">
          <img
            src="/logos/estimate-seal.png"
            alt="Zona Floors free in-home estimate seal, no pressure, no obligation"
            width="320" height="320" loading="eager" decoding="async"
            class="h-32 w-32 drop-shadow-xl sm:h-40 sm:w-40"
          />
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href="#lead-form"
             class={`zf-sheen rounded-xl bg-cta px-6 py-4 text-center text-lg font-extrabold text-white shadow-xl hover:bg-cta-dark sm:text-xl ${btnLift}`}>
            Get My Free Estimate →
          </a>
          <a href={telHref(phones.primary)} data-track-call
             class={`rounded-xl border-2 border-white/80 bg-white/10 px-6 py-4 text-center text-lg font-extrabold text-white backdrop-blur hover:bg-white/20 sm:text-xl ${btnLift}`}>
            Call {phone}
          </a>
        </div>
        <p class="mt-3 text-sm text-white/80">{ctaMicrocopy}</p>
      </div>
    </section>

    <!-- ===================== TOP DEALS (client lead-getter creatives) ===================== -->
    <section class="bg-gradient-to-b from-brand-dark to-brand">
      <div class="mx-auto max-w-5xl px-5 py-10 sm:py-14">
        <div data-reveal class="text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-pop px-4 py-1.5 text-sm font-extrabold uppercase tracking-wide text-brand-dark shadow-lg">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cta opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-cta"></span>
            </span>
            This month's deals
          </span>
          <h2 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">
            Two ways to say <span class="text-gold">yes</span> to new floors
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-lg text-white/80 sm:text-xl">
            Tap a deal to lock it into your free estimate.
          </p>
        </div>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {[creatives.speed3day, creatives.finance12].map((c, i) => (
            <a
              href="#lead-form"
              data-reveal
              data-reveal-delay={i + 1}
              class={`group relative block overflow-hidden rounded-3xl shadow-2xl ring-4 ring-pop ${btnLift}`}
            >
              <img
                src={c.src}
                alt={c.alt}
                width="1080"
                height="1080"
                loading="eager"
                decoding="async"
                class="block w-full transition-transform duration-500 group-hover:scale-105"
              />
              <span class="pointer-events-none absolute inset-0 rounded-3xl ring-1 ring-inset ring-black/10"></span>
              <!-- Hover/focus CTA sweep so the card reads as tappable. -->
              <span class="absolute inset-x-0 bottom-0 flex translate-y-full items-center justify-center gap-2 bg-cta/95 py-3 text-base font-extrabold uppercase tracking-wide text-white transition-transform duration-300 group-hover:translate-y-0 group-focus-visible:translate-y-0">
                Claim this deal <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== VALUE-PROP STRIP ===================== -->
    <section class="bg-brand-dark text-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-5 py-3 text-center text-sm font-extrabold uppercase tracking-wide sm:gap-x-7 sm:text-base">
        <span>Expert Install</span>
        <span class="text-gold" aria-hidden="true">★</span>
        <span>Honest Up-Front Pricing</span>
        <span class="text-gold" aria-hidden="true">★</span>
        <span>Licensed &amp; Local</span>
      </div>
    </section>

    <!-- ===================== TRUST ICON ROW (horizontal) ===================== -->
    <section class="border-b border-black/10 bg-gradient-to-b from-white to-brand/5">
      <div class="mx-auto grid max-w-5xl grid-cols-3 gap-2 px-3 py-7 sm:gap-6 sm:px-5">
        <div data-reveal data-reveal-delay="1" class="flex flex-col items-center gap-2 text-center sm:flex-row sm:gap-3 sm:text-left">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand text-white shadow-md sm:h-14 sm:w-14">
            <svg class="h-6 w-6 sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke-linejoin="round"/>
              <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>
            <span class="block font-extrabold leading-tight text-brand">AZ Licensed</span>
            <span class="block text-sm leading-tight text-brand/60" data-license>ROC #336899</span>
          </span>
        </div>
        <div data-reveal data-reveal-delay="2" class="flex flex-col items-center gap-2 text-center sm:flex-row sm:gap-3 sm:text-left">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gold text-white shadow-md sm:h-14 sm:w-14">
            <svg class="h-6 w-6 sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3 6.5 7 .6-5.3 4.6 1.6 6.9L12 17.5 5.7 20.6l1.6-6.9L2 9.1l7-.6L12 2z"/>
            </svg>
          </span>
          <span>
            <span class="block font-extrabold leading-tight text-brand">5-Star Rated</span>
            <span class="block text-sm leading-tight text-brand/60">on Google</span>
          </span>
        </div>
        <div data-reveal data-reveal-delay="3" class="flex flex-col items-center gap-2 text-center sm:flex-row sm:gap-3 sm:text-left">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-cta text-white shadow-md sm:h-14 sm:w-14">
            <svg class="h-6 w-6 sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 21s-7-5.5-7-11a7 7 0 1114 0c0 5.5-7 11-7 11z" stroke-linejoin="round"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </span>
          <span>
            <span class="block font-extrabold leading-tight text-brand">Phoenix Local</span>
            <span class="block text-sm leading-tight text-brand/60">Tempe-based crew</span>
          </span>
        </div>
      </div>
    </section>

    <!-- ===================== STATS BAND (real numbers, angled) ===================== -->
    <section
      class="relative bg-gradient-to-br from-brand-dark to-brand text-white"
      style="clip-path: polygon(0 24px, 100% 0, 100% 100%, 0 100%)"
    >
      <div class="mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 px-5 pb-14 pt-20 sm:grid-cols-4 sm:py-20">
        {stats.map((s, i) => (
          <div data-reveal data-reveal-delay={(i % 3) + 1} class="text-center">
            <div class="text-5xl font-extrabold leading-none tracking-tight text-pop sm:text-6xl">
              {s.num}<span class="text-gold">{s.unit}</span>
            </div>
            <div class="mt-2 text-sm font-semibold uppercase tracking-wide text-white/70">{s.label}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== PRIMARY LEAD FORM ===================== -->
    <section id="lead-form" class="bg-gradient-to-br from-brand-dark to-brand">
      <div data-reveal class="mx-auto max-w-lg px-5 py-14 sm:py-20">
        <div class="overflow-hidden rounded-2xl border-t-4 border-gold shadow-2xl">
          <LeadForm
            slug={SLUG}
            heading="Get your free hardwood estimate"
            submitLabel="Get My Free Estimate"
            projectLabel="Hardwood you're considering"
            projectName="hardwood_type"
            projectOptions={projectOptions}
            privacyNote={privacyNote}
          />
        </div>
      </div>
    </section>

    <!-- ===================== FREE IN-HOME ESTIMATE (showroom-to-your-door) ===================== -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-cta to-cta-dark text-white">
      <!-- Soft colored glow accents for depth + pop. -->
      <span class="pointer-events-none absolute -left-24 -top-24 -z-10 h-72 w-72 rounded-full bg-gold/30 blur-3xl" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -bottom-28 -right-20 -z-10 h-80 w-80 rounded-full bg-pop/25 blur-3xl" aria-hidden="true"></span>

      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <div data-reveal class="text-center">
          <span class="inline-flex items-center gap-2 rounded-full bg-pop px-4 py-1.5 text-sm font-extrabold uppercase tracking-wide text-brand-dark shadow-lg">
            <span aria-hidden="true">🚚</span> No showroom trip required
          </span>
          <h2 class="mx-auto mt-5 max-w-3xl text-4xl font-extrabold leading-[1.05] sm:text-5xl">
            We bring the showroom <span class="text-gold">to your door</span>
          </h2>
          <p class="mx-auto mt-4 max-w-2xl text-xl text-white/90 sm:text-2xl">
            {offer}. We show up with real samples, measure your space, and hand you a clear written price, right there in your living room.
          </p>
        </div>

        <!-- Interactive "what to expect" steps, hover/tap to expand the detail. -->
        <ol class="mt-12 grid gap-5 sm:grid-cols-3">
          {[
            { n: "1", icon: "🚪", title: "We come to you", body: "Pick a time that works. Our licensed crew arrives with samples in hand, no driving to a store." },
            { n: "2", icon: "🪵", title: "Match it in your light", body: "Lay real White Oak, Walnut & Maple against your walls and your daylight before you commit." },
            { n: "3", icon: "📝", title: "Written price on the spot", body: "Exact measurements, solid vs. engineered advice, and an all-in quote with zero surprises." },
          ].map((s, i) => (
            <li
              data-reveal
              data-reveal-delay={i + 1}
              tabindex="0"
              class={`group relative flex flex-col overflow-hidden rounded-2xl bg-white/10 p-7 text-left ring-1 ring-white/15 backdrop-blur focus:outline-none focus-visible:ring-2 focus-visible:ring-pop ${cardLift} hover:bg-white/15`}
            >
              <span class="absolute right-5 top-4 text-6xl font-extrabold leading-none text-white/10 transition-colors duration-300 group-hover:text-pop/30" aria-hidden="true">{s.n}</span>
              <span class="text-4xl" aria-hidden="true">{s.icon}</span>
              <span class="mt-4 text-2xl font-extrabold text-white sm:text-3xl">{s.title}</span>
              <span class="mt-2 text-lg leading-relaxed text-white/85 sm:text-xl">{s.body}</span>
              <!-- Accent bar sweeps in on hover/focus. -->
              <span class="mt-5 block h-1 w-12 origin-left rounded bg-gold transition-all duration-300 group-hover:w-full group-hover:bg-pop group-focus-visible:w-full"></span>
            </li>
          ))}
        </ol>

        <div data-reveal class="mt-12 flex flex-col items-center">
          <a href="#lead-form"
             class={`zf-sheen inline-flex items-center gap-2 rounded-xl bg-pop px-8 py-4 text-lg font-extrabold uppercase tracking-wide text-brand-dark shadow-xl sm:text-xl ${btnLift}`}>
            Book My Free Estimate <span aria-hidden="true">→</span>
          </a>
          <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-base text-white/90">
            <span class="inline-flex items-center gap-1.5"><span class="text-gold" aria-hidden="true">★★★★★</span> 5-Star rated</span>
            <span class="text-white/40" aria-hidden="true">·</span>
            <span>Takes about a minute</span>
            <span class="text-white/40" aria-hidden="true">·</span>
            <span>No obligation</span>
          </p>
          <p class="mt-3 text-lg text-white/90">
            Prefer to talk?
            <a href={telHref(phones.primary)} data-track-call class="font-extrabold text-gold underline underline-offset-2 hover:text-white">Call {phone}</a>
            or
            <a href={smsHref(phones.primary)} data-track-sms class="font-extrabold text-gold underline underline-offset-2 hover:text-white">text us</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== GUARANTEES ===================== -->
    <Guarantees
      heading="We put our money where your floor is"
      subhead="Every Zona Floors hardwood install comes with these guarantees, in writing. No surprises, no games."
    />

    <!-- ===================== DISCOUNT CREATIVE (senior + veterans) ===================== -->
    <CreativeBanner src={creatives.discount.src} alt={creatives.discount.alt} bg="bg-brand/5" />

    <!-- ===================== PRICING CREATIVE ===================== -->
    <CreativeBanner src={creatives.pricing.src} alt={creatives.pricing.alt} bg="bg-white" />

    <!-- ===================== ZONA QUALITY (was problem/solution) ===================== -->
    <ProblemSolution
      heading="Hardwood floors built to survive the Arizona desert"
      items={strengths}
    />

    <!-- ===================== SPECIES SELECTOR ===================== -->
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
        <div data-reveal class="text-center">
          <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">Pick your perfect hardwood 🪵</h2>
          <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
          <p class="mx-auto mt-4 max-w-xl text-xl text-brand/70 sm:text-2xl">
            Tap a look you love and we'll start your quote with it.
          </p>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {species.map((s, i) => (
            <button
              type="button"
              data-species={s.name}
              data-reveal
              data-reveal-delay={i + 1}
              class={`group flex flex-col overflow-hidden rounded-2xl border-2 border-brand/10 bg-white text-left hover:border-cta ${cardLift} ${btnLift}`}
            >
              <span class="relative block aspect-[4/3] overflow-hidden">
                <img
                  src={s.img}
                  alt={`${s.name} hardwood flooring`}
                  width="440"
                  height="330"
                  loading="lazy"
