---
/**
 * ProblemSolution, 2-4 concrete pain points paired with specific craft
 * solutions (claude.md page anatomy #6). No generic filler: content is passed
 * in per page from real intake facts.
 */
interface Item {
  problem: string;
  solution: string;
}
interface Props {
  items: Item[];
  heading?: string;
}
const { items, heading } = Astro.props;
---

<section class="bg-gradient-to-b from-brand/5 to-white">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">
    {heading && (
      <div data-reveal class="text-center">
        <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">{heading}</h2>
        <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
        <p class="mx-auto mt-4 max-w-2xl text-xl text-brand/70 sm:text-2xl">
          5-Star rated, licensed, and locally owned. We treat your home like it's our own.
        </p>
      </div>
    )}
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {items.map((item, i) => (
        <div
          data-reveal
          data-reveal-delay={(i % 3) + 1}
          class="group relative overflow-hidden rounded-2xl border-2 border-brand/10 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-cta/50 hover:shadow-2xl sm:p-8"
        >
          <!-- Colored accent bar that sweeps in on hover. -->
          <span class="absolute inset-x-0 top-0 h-1.5 origin-left scale-x-0 bg-gradient-to-r from-cta via-gold to-cta transition-transform duration-300 group-hover:scale-x-100"></span>
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cta/10 text-cta ring-1 ring-cta/20 transition-colors duration-300 group-hover:bg-cta group-hover:text-white">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div>
              <p class="text-xl font-extrabold leading-snug text-cta sm:text-2xl">{item.problem}</p>
              <p class="mt-3 text-lg leading-relaxed text-ink/80 sm:text-xl">{item.solution}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
