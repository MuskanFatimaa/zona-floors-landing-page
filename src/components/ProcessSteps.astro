---
/**
 * ProcessSteps — three-step process (claude.md page anatomy #7).
 * Content is passed in per page (unique copy per page); this component only
 * provides the layout.
 */
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
  heading?: string;
}
const { steps, heading = "How It Works" } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-center text-3xl font-extrabold text-brand">{heading}</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-3">
      {steps.map((step, i) => (
        <li class="rounded-2xl bg-brand/5 p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-cta text-lg font-extrabold text-white">
            {i + 1}
          </div>
          <h3 class="mt-4 text-xl font-bold text-brand">{step.title}</h3>
          <p class="mt-2 text-brand/80">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
