---
/**
 * ProcessSteps, three-step process (claude.md page anatomy #7).
 * Content is passed in per page (unique copy per page); this component only
 * provides the layout.
 */
interface Step {
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
  heading?: string;
}
const { steps, heading = "How It Works" } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <div data-reveal class="text-center">
      <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">{heading}</h2>
      <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
    </div>
    <ol class="mt-12 grid gap-6 sm:grid-cols-3">
      {steps.map((step, i) => (
        <li
          data-reveal
          data-reveal-delay={i + 1}
          class="group rounded-2xl border-2 border-brand/10 bg-brand/5 p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-cta/40 hover:bg-white hover:shadow-2xl sm:p-8"
        >
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-cta text-2xl font-extrabold text-white shadow-md ring-4 ring-gold/30 transition-transform duration-300 group-hover:scale-110">
            {i + 1}
          </div>
          <h3 class="mt-5 text-2xl font-bold text-brand sm:text-[1.75rem]">{step.title}</h3>
          <p class="mt-3 text-lg leading-relaxed text-brand/80 sm:text-xl">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
