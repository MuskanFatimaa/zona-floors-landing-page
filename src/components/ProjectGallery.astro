---
/**
 * ProjectGallery — 3+ real project photos with descriptive labels
 * (claude.md page anatomy #5). Photos come from siteConfig per service; labels
 * are passed in per page. Images lazy-load (the hero image is the only priority
 * image, handled in the hero, not here).
 */
interface GalleryPhoto {
  src: string;
  label: string;
}
interface Props {
  photos: GalleryPhoto[];
  heading?: string;
}
const { photos, heading = "Recent Projects" } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    <div data-reveal class="text-center">
      <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">{heading}</h2>
      <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((p, i) => (
        <figure
          data-reveal
          data-reveal-delay={(i % 3) + 1}
          class="group overflow-hidden rounded-2xl border-2 border-brand/10 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-gold/60 hover:shadow-xl"
        >
          <div class="overflow-hidden">
            <img
              src={p.src}
              alt={p.label}
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </div>
          <figcaption class="flex items-center gap-2.5 px-5 py-4 text-lg font-semibold text-brand sm:text-xl">
            <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-gold ring-2 ring-gold/30"></span>
            {p.label}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
