---
/**
 * ProjectGallery — 3+ real project photos with descriptive labels
 * (claude.md page anatomy #5). Photos come from siteConfig per service; labels
 * are passed in per page. Images lazy-load (the hero image is the only priority
 * image, handled in the hero, not here).
 */
interface GalleryPhoto {
  src: string;
  label: string;
}
interface Props {
  photos: GalleryPhoto[];
  heading?: string;
}
const { photos, heading = "Recent Projects" } = Astro.props;
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-center text-3xl font-extrabold text-brand">{heading}</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((p) => (
        <figure class="overflow-hidden rounded-2xl shadow-sm ring-1 ring-black/5">
          <img
            src={p.src}
            alt={p.label}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="px-4 py-3 text-brand/80">{p.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
