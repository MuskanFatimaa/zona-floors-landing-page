---
/**
 * LeadForm — residential lead capture (claude.md "Architecture" + "Forms").
 *
 *  - Fields: name, phone, ZIP. Phone is the only thing that matters; no email.
 *  - Honeypot field (visually hidden, tabindex -1, aria-hidden) dropped server-side.
 *  - SMS/TCPA consent text renders adjacent to the phone field (non-negotiable #2).
 *  - Hidden attribution inputs (click IDs + utm_* + keyword) are populated
 *    client-side from first-touch localStorage before submit.
 *  - Posts to /api/submit-lead, which forwards to the CRM and 303-redirects to
 *    /thank-you.
 */
import { siteConfig } from "@/lib/siteConfig";
import { ATTRIBUTION_PARAMS } from "@/lib/tracking";

interface Props {
  /** Page/ad-group slug, sent with the lead. */
  slug: string;
  /** Submit button text. */
  submitLabel?: string;
  /** Optional form heading. */
  heading?: string;
  /** Optional, non-required dropdown (e.g. "Hardwood you're considering"). */
  projectLabel?: string;
  /** Field name for the optional dropdown. */
  projectName?: string;
  /** Options for the optional dropdown. When empty, the field is not rendered. */
  projectOptions?: string[];
  /** Short reassurance line under the submit button. */
  privacyNote?: string;
}
const {
  slug,
  submitLabel = "Get My Free Quote",
  heading,
  projectLabel,
  projectName = "project_type",
  projectOptions = [],
  privacyNote,
} = Astro.props;
const consent = siteConfig.consent.sms;
const showProject = projectOptions.length > 0;
---

<form
  method="POST"
  action="/api/submit-lead"
  data-lead-form
  class="rounded-2xl bg-white p-5 shadow-lg ring-1 ring-black/5"
>
  {heading && <h2 class="mb-4 text-2xl font-extrabold text-brand">{heading}</h2>}

  <input type="hidden" name="page_slug" value={slug} />
  {ATTRIBUTION_PARAMS.map((p) => <input type="hidden" name={p} data-attr={p} value="" />)}

  {/* Honeypot — real users never see or fill this. */}
  <div class="zf-hp" aria-hidden="true">
    <label>
      Company
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="grid gap-4">
    <label class="block">
      <span class="mb-1 block font-semibold text-brand">Name</span>
      <input
        type="text"
        name="name"
        required
        autocomplete="name"
        class="w-full rounded-lg border border-black/20 px-4 py-3 text-lg focus:border-cta focus:outline-none focus:ring-2 focus:ring-cta/30"
      />
    </label>

    <label class="block">
      <span class="mb-1 block font-semibold text-brand">Phone</span>
      <input
        type="tel"
        name="phone"
        required
        inputmode="tel"
        autocomplete="tel"
        aria-describedby="sms-consent"
        class="w-full rounded-lg border border-black/20 px-4 py-3 text-lg focus:border-cta focus:outline-none focus:ring-2 focus:ring-cta/30"
      />
      {/* Consent text adjacent to the phone field (non-negotiable #2). */}
      <p id="sms-consent" data-consent class="mt-2 text-xs leading-snug text-brand/60">
        {consent || "[SMS consent text REQUIRED — supply siteConfig.consent.sms before launch]"}
      </p>
    </label>

    <label class="block">
      <span class="mb-1 block font-semibold text-brand">ZIP Code</span>
      <input
        type="text"
        name="zip"
        required
        inputmode="numeric"
        pattern="[0-9]{5}"
        maxlength="5"
        autocomplete="postal-code"
        class="w-full rounded-lg border border-black/20 px-4 py-3 text-lg focus:border-cta focus:outline-none focus:ring-2 focus:ring-cta/30"
      />
    </label>

    {showProject && (
      <label class="block">
        <span class="mb-1 block font-semibold text-brand">
          {projectLabel}
          <span class="font-normal text-brand/50"> (optional)</span>
        </span>
        <select
          name={projectName}
          data-project-select
          class="w-full rounded-lg border border-black/20 bg-white px-4 py-3 text-lg focus:border-cta focus:outline-none focus:ring-2 focus:ring-cta/30"
        >
          <option value="">I'm not sure yet</option>
          {projectOptions.map((opt) => <option value={opt}>{opt}</option>)}
        </select>
      </label>
    )}

    <button
      type="submit"
      class="mt-1 flex w-full items-center justify-center gap-2 rounded-lg bg-cta px-5 py-4 text-xl font-extrabold text-white shadow-sm transition-colors hover:bg-cta-dark disabled:opacity-60"
    >
      {submitLabel}
      <span aria-hidden="true">→</span>
    </button>

    {privacyNote && (
      <p class="text-center text-xs text-brand/55">{privacyNote}</p>
    )}
  </div>
</form>

<script>
  import { captureClickIds, getAttribution } from "@/lib/tracking";

  // Ensure first-touch is captured, then fill hidden attribution inputs.
  captureClickIds();
  const attr = getAttribution();
  document.querySelectorAll<HTMLInputElement>("[data-attr]").forEach((input) => {
    const key = input.dataset.attr as keyof typeof attr;
    if (key && attr[key]) input.value = attr[key] as string;
  });

  // Prevent double-submits.
  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.disabled = true;
    });
  });
</script>
