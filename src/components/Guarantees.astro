---
/**
 * Guarantees — committed conversion guarantees as a card grid.
 * Config-driven: reads approved guarantees from siteConfig (never hardcoded).
 * Matches the page design system (large type, outlined cards, hover lift,
 * colored accent icons, gold rule).
 */
import { approvedGuarantees, type Guarantee } from "@/lib/siteConfig";

interface Props {
  heading?: string;
  subhead?: string;
  /** Defaults to all approved guarantees from config. */
  items?: Guarantee[];
}
const {
  heading = "Backed by real guarantees",
  subhead,
  items = approvedGuarantees(),
} = Astro.props;

// Inline icon inner-markup per guarantee key (24x24, stroked). Falls back to a
// shield-check if a key has no mapped icon.
const ICONS: Record<string, string> = {
  warranty:
    '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>',
  "price-match":
    '<path d="M20.5 13.4l-7.1 7.1a2 2 0 01-2.8 0L2 11.8V4a2 2 0 012-2h7.8l8.7 8.6a2 2 0 010 2.8z" stroke-linejoin="round"/><circle cx="7.5" cy="7.5" r="1.4"/>',
  upfront:
    '<path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke-linejoin="round"/><path d="M9 5a2 2 0 012-2h2a2 2 0 012 2v1H9V5z" stroke-linejoin="round"/><path d="M9 13l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>',
  speed:
    '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" stroke-linejoin="round"/>',
  discount:
    '<circle cx="12" cy="9" r="5"/><path d="M9 13.2L7.5 22l4.5-3 4.5 3-1.5-8.8" stroke-linejoin="round"/>',
  "install-only":
    '<path d="M21 8l-9-5-9 5 9 5 9-5z" stroke-linejoin="round"/><path d="M3 8v8l9 5 9-5V8" stroke-linejoin="round"/><path d="M12 13v8" stroke-linecap="round"/>',
  "price-anchor":
    '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M14.5 9.3c0-1.1-1.1-1.8-2.5-1.8s-2.5.8-2.5 1.9 1.1 1.7 2.5 1.7 2.5.8 2.5 1.9-1.1 1.9-2.5 1.9-2.5-.8-2.5-1.9" stroke-linecap="round" stroke-linejoin="round"/>',
  financing:
    '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 9.5h19" stroke-linecap="round"/><path d="M6 14.5h4" stroke-linecap="round"/>',
};

const TONES = [
  "from-brand to-brand-dark",
  "from-cta to-cta-dark",
  "from-gold to-cta",
  "from-brand-dark to-brand",
  "from-cta to-gold",
  "from-brand to-cta",
];
---

{items.length > 0 && (
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
      <div data-reveal class="text-center">
        <h2 class="text-3xl font-extrabold text-brand sm:text-4xl">{heading}</h2>
        <span class="mx-auto mt-4 block h-1 w-20 rounded bg-gold"></span>
        {subhead && (
          <p class="mx-auto mt-4 max-w-2xl text-xl text-brand/70 sm:text-2xl">{subhead}</p>
        )}
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((g, i) => (
          <li
            data-reveal
            data-reveal-delay={(i % 3) + 1}
            class="group relative flex flex-col overflow-hidden rounded-2xl border-2 border-brand/10 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-gold/60 hover:shadow-xl"
          >
            <span class="absolute inset-x-0 top-0 h-1.5 origin-left scale-x-0 bg-gradient-to-r from-gold via-cta to-gold transition-transform duration-300 group-hover:scale-x-100"></span>
            <span class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br ${TONES[i % TONES.length]} text-white shadow-md transition-transform duration-300 group-hover:scale-110`}>
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={ICONS[g.key] ?? ICONS.warranty}></svg>
            </span>
            <h3 class="mt-5 text-2xl font-extrabold text-brand">{g.label}</h3>
            <p class="mt-2 grow text-lg leading-relaxed text-brand/75 sm:text-xl">{g.text}</p>
            {g.note && <p class="mt-3 text-sm text-brand/45">{g.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
