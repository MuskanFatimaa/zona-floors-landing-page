---
/**
 * ReviewCard, one verbatim review with the reviewer's name (claude.md
 * page anatomy #5). Renders only verbatim text; paraphrased summaries are never
 * shown to visitors.
 */
import type { ReviewQuote } from "@/lib/siteConfig";

interface Props {
  review: ReviewQuote;
}
const { review } = Astro.props;
const stars = typeof review.rating === "number" ? review.rating : 5;
---

<figure class="flex h-full flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
  <div aria-hidden="true" class="text-cta">{"★".repeat(stars)}</div>
  <blockquote class="mt-2 grow text-lg leading-relaxed text-brand">
    “{review.verbatim}”
  </blockquote>
  <figcaption class="mt-3 font-bold text-brand/80">, {review.name}</figcaption>
</figure>
